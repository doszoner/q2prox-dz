#!/usr/bin/env bash
set -euo pipefail
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
INSTALL_ROOT="${Q2DZ_INSTALL_ROOT:-$DATA_HOME/q2dz}"
SESSION="${Q2DZ_SESSION_BIN:-$INSTALL_ROOT/bin/q2dz-session}"
MANAGED="${Q2DZ_MANAGED_GATEWAY:-$INSTALL_ROOT/bin/q2dz-managed-gateway}"
ADAPTER="${Q2DZ_ADAPTER_CONFIG:-$INSTALL_ROOT/config/legacy-gateway.json}"
LEGACY="${Q2DZ_LEGACY_GATEWAY:-$INSTALL_ROOT/bin/q2dz-webrtc-gateway}"
[[ ! -t 0 ]] || { echo "room JSON must be supplied on stdin; it is never accepted in argv or environment" >&2; exit 64; }
args=(--gateway "$MANAGED" --legacy-gateway "$LEGACY" --adapter "$ADAPTER" --game 3zb2)
if [[ -n "${Q2DZ_Q2_EXE:-}" ]]; then args+=(--q2 "$Q2DZ_Q2_EXE"); fi
if [[ -n "${Q2DZ_WINE:-}" ]]; then args+=(--wine "$Q2DZ_WINE"); fi
if [[ -n "${WINEPREFIX:-}" ]]; then args+=(--wineprefix "$WINEPREFIX"); fi
if [[ -n "${Q2DZ_MAP:-}" ]]; then args+=(--map "$Q2DZ_MAP"); fi
if [[ "${Q2DZ_REQUIRE_CONTENT:-0}" == 1 ]]; then args+=(--require-content); fi
exec "$SESSION" "${args[@]}"
