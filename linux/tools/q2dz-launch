class LaunchError(RuntimeError):
    def __init__(self, message, category="other"):
        super().__init__(message)
        self.category = category


_LOG_MAX_BYTES = 5 * 1024 * 1024


class _SessionLog:
    """Launcher-owned session log: sole writer, size rotation, stderr fallback."""

    def __init__(self):
        self.stream = None
        self.path = None

    def open(self, state_dir):
        try:
            directory = Path(state_dir) / "logs"
            directory.mkdir(mode=0o700, parents=True, exist_ok=True)
            path = directory / "q2dz.log"
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            os.chmod(path, 0o600)
            self.stream = os.fdopen(fd, "a", encoding="utf-8")
            self.path = path
        except OSError:
            self.stream = None
            self.path = None

    def _rotate(self):
        self.stream.close()
        rotated = self.path.with_name("q2dz.1.log")
        try:
            os.replace(self.path, rotated)
        except FileNotFoundError:
            pass
        fd = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        self.stream = os.fdopen(fd, "w", encoding="utf-8")

    def write(self, line):
        if self.stream is None:
            return
        try:
            if self.stream.tell() >= _LOG_MAX_BYTES:
                self._rotate()
            self.stream.write(line + "\n")
            self.stream.flush()
        except OSError:
            self.close()

    def close(self):
        if self.stream is not None:
            try:
                self.stream.close()
            except OSError:
                pass
        self.stream = None


_session_log = _SessionLog()


def session_log_line(text):
    """Write one event line to stderr and to the session log when it is open."""
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{stamp} {text}"
    try:
        print(line, file=sys.stderr, flush=True)
    except (OSError, ValueError):
        pass
    _session_log.write(line)


def catalog_event(message):
    session_log_line(f"LAUNCHER {message}")


# The child-stderr allow-list filter mirrors contains_sensitive_key +
# sanitize_log_line in linux/src/common.cpp; keep both lists identical.
_SENSITIVE_SUBSTRINGS = (
    "credential", "password", "secret", "token", "authorization", "ice",
    "candidate", "sdp", "turn:", "turns:", "username", "fingerprint",
    "local-description", "remote-description", "session-description",
    "peer id", "peer_id", "peerid", "alias=", 'alias "', "alias lookup",
    "aliaserror",
)
_SDP_FIELD_LETTERS = frozenset("vosiuepcbtrzkam")
_EVENT_FIELD = re.compile(r"[A-Za-z_][A-Za-z0-9_]*=[A-Za-z0-9._:-]{1,64}\Z")
_ROOM_FIELD = re.compile(r"room=[A-Za-z0-9._-]{1,255}\Z")


def _line_sensitive(line):
    lowered = line.casefold()
    if any(key in lowered for key in _SENSITIVE_SUBSTRINGS):
        return True
    return len(line) >= 2 and line[1] == "=" and line[0].lower() in _SDP_FIELD_LETTERS


_EVENT_KEYS = {
    "TARGET": {"room", "id", "state", "reason", "recovery", "retry", "published_ready"},
    "SESSION start": {"build", "session", "instance", "gateway_restarts"},
    "SESSION stop": {"reason", "rc"},
    "GATEWAY event": {"event", "reason", "restarts"},
    "GATEWAY error": {"reason"},
    "GATEWAY stop": {
        "max_udp_to_transport_datagram", "max_transport_to_udp_datagram",
        "oversized_udp_drops", "oversized_transport_drops",
    },
}


def _event_field_valid(field, allowed_keys):
    key, sep, _value = field.partition("=")
    if not sep or key not in allowed_keys:
        return False
    if key == "room":
        return bool(_ROOM_FIELD.fullmatch(field))
    if not _EVENT_FIELD.fullmatch(field):
        return False
    return not _line_sensitive(field)


def _child_component(tokens):
    """Allow-listed child event → its log component; '' = already tagged, None = not an event."""
    if tokens[0] == "TARGET":
        component, fields, spec = "COORDINATOR", tokens[1:], "TARGET"
    elif tokens[0] == "SESSION" and len(tokens) > 1 and tokens[1] in ("start", "stop"):
        component, fields, spec = "COORDINATOR", tokens[2:], f"SESSION {tokens[1]}"
    elif tokens[0] == "GATEWAY" and len(tokens) > 1 and tokens[1].startswith("event="):
        component, fields, spec = "COORDINATOR", tokens[1:], "GATEWAY event"
    elif tokens[0] == "GATEWAY" and len(tokens) > 1 and tokens[1] in ("error", "stop"):
        component, fields, spec = "", tokens[2:], f"GATEWAY {tokens[1]}"
    else:
        return None
    allowed_keys = _EVENT_KEYS.get(spec)
    if allowed_keys is None:
        return None
    return component if all(_event_field_valid(field, allowed_keys) for field in fields) else None


def _child_log_text(line):
    """Map one raw child-stderr line to its log line (D11 filter + allow-list).

    A line that fully matches the event grammar passes through untouched,
    even if it contains a filter substring (e.g. room=room.q2ded.nice) — the
    substring filter only applies to lines outside the grammar.
    """
    full_line = line
    tokens = full_line.split(" ")
    component = _child_component(tokens) if len(tokens) > 1 else None
    if component == "":
        return full_line
    if component is not None:
        return f"{component} {full_line}"
    line = full_line[:2048]
    if _line_sensitive(full_line):
        return "LAUNCHER CHILD suppressed=1"
    escaped = "".join(
        char if char == "\t" or (0x20 <= ord(char) != 0x7F) else " " for char in line
    )
    return f"LAUNCHER CHILD line={escaped[:512]}"


def _read_stderr_lines(stream, lines):
    try:
        for raw in iter(stream.readline, b""):
            if not raw:
                break
            lines.put(raw.decode("utf-8", "replace").rstrip("\r\n"))
    except (OSError, ValueError):
        pass


def _drain_stderr(lines):
    while True:
        try:
            line = lines.get_nowait()
        except queue.Empty:
            return
        session_log_line(_child_log_text(line))


