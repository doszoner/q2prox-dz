#!/usr/bin/env python3
"""Small Linux room-hub launcher for the managed Q2PRO-X Dos.Zone session."""

import gzip
import socket
import json
import dataclasses
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import ipaddress
import urllib.error
import urllib.request
import webbrowser
from pathlib import Path


ROOM_ENDPOINT = "https://cloud.dos.zone/room/get"
LOOKUP_ENDPOINT = "https://net.dos.zone/lookup"
RTC_ENDPOINT = "https://cloud.dos.zone/rtc/servers"
SIGNALING_URL = "wss://net.js-dos.com:444"
OFFICIAL_URL = "https://q2pro-x.com/"
GAME = "3zb2"
FETCH_TIMEOUT = 15
MAX_BODY = 2 * 1024 * 1024
ROOM_CLOSED_EXIT = 73
MAX_HUB_TARGETS = 256
MAX_ICE_SNAPSHOT_BYTES = 65536
MAX_HUB_COMMAND_BYTES = 256 * 1024
MAX_GATEWAY_CONFIG_BYTES = 65535
HUB_POLL_SECONDS = 15.0
_AUTO = object()
MAX_TOKEN = 255
MAX_OWNER = 250
MAX_JSON_SAFE_INTEGER = 9007199254740991
MAX_MAP = 128
MAX_PLAYERS = 64
MAX_ICE_SERVERS = 16
MAX_ICE_URL = 2048
MAX_ICE_FIELD = 1024
SAFE_TOKEN = re.compile(r"^[A-Za-z0-9._-]+\Z")
HOSTNAME = re.compile(
    r"^(?=.{1,253}\Z)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+"
    r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\Z"
)


class LaunchError(RuntimeError):
    pass


@dataclasses.dataclass
class HubTarget:
    room_id: str
    config: str
    misses: int = 0
    map_name: str = ""


@dataclasses.dataclass
class TargetPlan:
    targets: dict[str, HubTarget]
    ice_servers: list[dict]
    drops: tuple[str, ...] = ()


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, _request, _fp, _code, _msg, _headers, _new_url):
        raise LaunchError("Dos.Zone endpoint returned an unexpected redirect")


def _open_url(request, timeout):
    opener = urllib.request.build_opener(_NoRedirect)
    return opener.open(request, timeout=timeout)


def _remaining(deadline):
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise LaunchError("Dos.Zone response timed out")
    return remaining


def _set_response_timeout(response, remaining):
    timeout = max(remaining, 0.001)
    candidates = [getattr(response, "fp", None), getattr(response, "raw", None)]
    for candidate in candidates:
        raw = getattr(candidate, "raw", None) or candidate
        sock = getattr(raw, "_sock", None)
        setter = getattr(sock, "settimeout", None)
        if setter:
            setter(timeout)
            return


def _read_chunk(response, size, deadline):
    remaining = _remaining(deadline)
    _set_response_timeout(response, remaining)
    try:
        chunk = response.read(size)
    except (socket.timeout, TimeoutError) as exc:
        raise LaunchError("Dos.Zone response timed out") from exc
    _remaining(deadline)
    return chunk


class _DeadlineReader:
    def __init__(self, response, deadline, maximum=MAX_BODY):
        self.response = response
        self.deadline = deadline
        self.bytes_read = 0
        self.maximum = maximum

    def read(self, size=-1):
        if size == 0:
            return b""
        requested = 65536 if size is None or size < 0 else size
        remaining = self.maximum - self.bytes_read
        if remaining < 0:
            raise LaunchError("Dos.Zone response is too large before decompression")
        # Read one byte beyond the exact bound so a response ending exactly at
        # MAX_BODY can still prove EOF; reject as soon as a 2MiB+1 byte arrives.
        requested = min(requested, remaining + 1)
        chunk = _read_chunk(self.response, requested, self.deadline)
        self.bytes_read += len(chunk)
        if self.bytes_read > self.maximum:
            raise LaunchError("Dos.Zone response is too large before decompression")
        return chunk


def _read_bounded(response, deadline):
    raw_encoding = response.headers.get("Content-Encoding")
    encoding = "" if raw_encoding is None else str(raw_encoding)
    if encoding == "":
        is_gzip = False
    elif encoding.casefold() == "gzip":
        is_gzip = True
    else:
        raise LaunchError("Dos.Zone endpoint returned an unsupported content encoding")
    if not is_gzip:
        body = bytearray()
        while True:
            chunk = _read_chunk(response, 65536, deadline)
            if not chunk:
                break
            body.extend(chunk)
            if len(body) > MAX_BODY:
                raise LaunchError("Dos.Zone response is too large")
        return bytes(body)

    body = bytearray()
    try:
        with gzip.GzipFile(fileobj=_DeadlineReader(response, deadline)) as stream:
            while True:
                _remaining(deadline)
                chunk = stream.read(65536)
                if not chunk:
                    break
                body.extend(chunk)
                if len(body) > MAX_BODY:
                    raise LaunchError("Dos.Zone response is too large after decompression")
    except LaunchError:
        raise
    except (OSError, EOFError) as exc:
        raise LaunchError("Dos.Zone returned invalid gzip data") from exc
    return bytes(body)


def fetch_json(url, opener=None, timeout=FETCH_TIMEOUT):
    """Fetch one allow-listed HTTPS endpoint, with bounded gzip/JSON input."""
    if url not in {ROOM_ENDPOINT, LOOKUP_ENDPOINT, RTC_ENDPOINT}:
        raise LaunchError("unapproved Dos.Zone endpoint")
    opener = opener or _open_url
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/json",
            "Accept-Encoding": "gzip",
            "User-Agent": "q2pro-x-doszone/1.0",
        },
    )
    deadline = time.monotonic() + timeout
    try:
        with opener(request, _remaining(deadline)) as response:
            status = getattr(response, "status", None)
            if status is None:
                getcode = getattr(response, "getcode", None)
                status = getcode() if callable(getcode) else None
            if status is not None and not 200 <= int(status) < 300:
                raise LaunchError("Dos.Zone endpoint returned a non-success status")
            body = _read_bounded(response, deadline)
    except LaunchError:
        raise
    except (OSError, urllib.error.URLError, urllib.error.HTTPError) as exc:
        raise LaunchError(f"cannot fetch {url}: {exc}") from exc
    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise LaunchError(f"invalid JSON from {url}") from exc


def _is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def _safe_token(value, maximum=MAX_TOKEN):
    return isinstance(value, str) and 1 <= len(value) <= maximum and SAFE_TOKEN.fullmatch(value) is not None


def _text(value, maximum=MAX_TOKEN):
    return isinstance(value, str) and 1 <= len(value) <= maximum and not any(char.isspace() and char != " " for char in value)


def _hostname(value):
    return isinstance(value, str) and HOSTNAME.fullmatch(value) is not None


def _ice_url(value):
    if not isinstance(value, str) or not 7 <= len(value) <= MAX_ICE_URL or re.search(r"\s|@", value):
        return False
    match = re.fullmatch(r"(?i)(stun|stuns|turn|turns):(.+)", value)
    if not match:
        return False
    target = match.group(2).split("?", 1)[0]
    if not target:
        return False
    if target.startswith("["):
        closing = target.find("]")
        if closing < 0:
            return False
        host = target[1:closing]
        port = target[closing + 1:]
        if port and not re.fullmatch(r":\d{1,5}", port):
            return False
    else:
        if target.count(":") > 1:
            return False
        host, separator, port = target.partition(":")
        if separator and not re.fullmatch(r"\d{1,5}", port):
            return False
    try:
        address_ok = bool(ipaddress.ip_address(host))
    except ValueError:
        address_ok = _hostname(host)
    if not address_ok:
        return False
    if port and not 1 <= int(port.lstrip(":")) <= 65535:
        return False
    return True


def _ice_server(value):
    if not isinstance(value, dict):
        return False
    if "ordered" in value and value["ordered"] is not False:
        return False
    urls = value.get("urls")
    urls = urls if isinstance(urls, list) else [urls]
    if not 1 <= len(urls) <= MAX_ICE_SERVERS or not all(_ice_url(url) for url in urls):
        return False
    for name in ("username", "credential"):
        if name in value and (not isinstance(value[name], str) or len(value[name]) > MAX_ICE_FIELD):
            return False
    return True


def _rtc_row(value):
    return (
        isinstance(value, dict)
        and ("ordered" not in value or value["ordered"] is False)
        and _hostname(value.get("domain"))
        and isinstance(value.get("iceservers"), list)
        and 1 <= len(value["iceservers"]) <= MAX_ICE_SERVERS
        and all(_ice_server(server) for server in value["iceservers"])
    )


def validate_rtc_payload(payload):
    return isinstance(payload, list) and 1 <= len(payload) and all(_rtc_row(row) for row in payload)


def validate_alias_payload(payload):
    return (
        isinstance(payload, dict)
        and isinstance(payload.get("aliases"), list)
        and all(_safe_token(alias) for alias in payload["aliases"])
        and len(payload["aliases"]) == len(set(payload["aliases"]))
    )


def _strict_room(row):
    if not isinstance(row, dict):
        return False
    settings = row.get("createSettings")
    if not isinstance(settings, dict) or settings.get("prefix") not in ("q2", "q2ded"):
        return False
    kind = settings["prefix"]
    if any(field in settings and settings[field] != GAME for field in ("game", "profile")):
        return False
    if "ordered" in settings and settings["ordered"] is not False:
        return False
    if not _safe_token(row.get("room")):
        return False
    if kind == "q2":
        owner = row.get("owner")
        if isinstance(owner, bool) or not isinstance(owner, (str, int)):
            return False
        if isinstance(owner, str):
            if not _safe_token(owner, MAX_OWNER):
                return False
        elif not 0 <= owner <= MAX_JSON_SAFE_INTEGER:
            return False
        if not isinstance(row.get("roomReady"), bool) or not _hostname(row.get("rtcServer")):
            return False
    elif not row["room"].startswith("room.q2ded.") or len(row["room"]) <= len("room.q2ded."):
        return False
    if not _text(settings.get("name")):
        return False
    map_name = settings.get("map")
    if not isinstance(map_name, str) or not 1 <= len(map_name) <= MAX_MAP or not SAFE_TOKEN.fullmatch(map_name):
        return False
    maximum = settings.get("maxPlayers")
    players = row.get("players")
    return (
        _is_int(maximum)
        and 1 <= maximum <= MAX_PLAYERS
        and _is_int(players)
        and 0 <= players <= maximum
    )


def validate_room_payload(payload):
    if not isinstance(payload, dict) or not isinstance(payload.get("rooms"), list):
        return False
    supported_count = 0
    seen_rooms = set()
    seen_aliases = set()
    for row in payload["rooms"]:
        if not isinstance(row, dict):
            continue
        settings = row.get("createSettings")
        if not isinstance(settings, dict) or settings.get("prefix") not in ("q2", "q2ded"):
            continue
        supported_count += 1
        if not _strict_room(row):
            return False
        if row["room"] in seen_rooms:
            return False
        seen_rooms.add(row["room"])
        alias = _room_alias(row)
        if alias in seen_aliases:
            return False
        seen_aliases.add(alias)
    return supported_count > 0


def ready_rooms(payload):
    if not isinstance(payload, dict) or not isinstance(payload.get("rooms"), list):
        raise LaunchError("room catalog has an invalid schema")
    strict_rows = [row for row in payload["rooms"] if _strict_room(row)]
    room_ids = [row["room"] for row in strict_rows]
    if len(room_ids) != len(set(room_ids)):
        raise LaunchError("room catalog has duplicate room ids")
    aliases = [_room_alias(row) for row in strict_rows]
    if len(aliases) != len(set(aliases)):
        raise LaunchError("room catalog has duplicate Q2 aliases")
    rows = [row for row in strict_rows if row["createSettings"]["prefix"] == "q2ded" or row["roomReady"]]
    return sorted(rows, key=lambda row: row["room"])


def joinable_rooms(payload):
    return [
        row for row in ready_rooms(payload)
        if row["players"] < row["createSettings"]["maxPlayers"]
    ]


def registered_rooms(rows, lookup):
    if not validate_alias_payload(lookup):
        raise LaunchError("alias lookup has an invalid schema")
    registered = set(lookup["aliases"])
    return [row for row in rows if _room_alias(row) in registered]


def _room_kind(row):
    return row["createSettings"]["prefix"]


def _room_alias(row):
    return row["room"] if _room_kind(row) == "q2ded" else f"q2.{row['owner']}"


def _ice_snapshot(rtc_rows):
    if not validate_rtc_payload(rtc_rows):
        raise LaunchError("RTC configuration has an invalid schema")
    result = []
    seen = set()
    for row in rtc_rows:
        for server in row["iceservers"]:
            key = json.dumps(server, separators=(",", ":"), sort_keys=True, ensure_ascii=False)
            if key not in seen:
                seen.add(key)
                result.append(server)
    if not 1 <= len(result) <= MAX_ICE_SERVERS:
        raise LaunchError("global RTC configuration exceeds the supported limit")
    snapshot_bytes = bytearray()
    try:
        try:
            snapshot_bytes.extend(
                json.dumps(result, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
            )
        except (TypeError, UnicodeError, ValueError) as exc:
            raise LaunchError("global ICE snapshot is not valid UTF-8 JSON") from exc
        if len(snapshot_bytes) > MAX_ICE_SNAPSHOT_BYTES:
            raise LaunchError("global ICE snapshot exceeds 65536 bytes")
    finally:
        snapshot_bytes[:] = b"\x00" * len(snapshot_bytes)
    return result


def _dedicated_ice_servers(rtc_rows):
    return _ice_snapshot(rtc_rows)


def _config_text(config):
    if isinstance(config, str):
        text = config
    else:
        try:
            text = json.dumps(config, separators=(",", ":"), ensure_ascii=False)
        except (TypeError, ValueError) as exc:
            raise LaunchError("room configuration cannot be serialized") from exc
    if not text or "\n" in text or "\r" in text:
        raise LaunchError("room configuration must fit one line")
    try:
        text.encode("utf-8")
    except UnicodeEncodeError as exc:
        raise LaunchError("room configuration is not valid UTF-8") from exc
    return text


def _command_line(payload):
    payload_bytes = bytearray()
    try:
        try:
            payload_bytes.extend(payload.encode("utf-8"))
        except UnicodeEncodeError as exc:
            raise LaunchError("hub command is not valid UTF-8") from exc
        if len(payload_bytes) > MAX_HUB_COMMAND_BYTES:
            raise LaunchError("hub command exceeds 256 KiB")
        return payload
    finally:
        payload_bytes[:] = b"\x00" * len(payload_bytes)


def encode_ice(generation, ice_servers):
    if not _is_int(generation) or generation < 1:
        raise LaunchError("invalid ICE generation")
    return _command_line(
        f"Q2DZ/ROOMS/2 ICE generation={generation} json={_config_text(ice_servers)}\n"
    )


def encode_put(target):
    if not isinstance(target, HubTarget) or not _safe_token(target.room_id):
        raise LaunchError("target has no safe room id")
    return _command_line(f"Q2DZ/ROOMS/2 PUT room={target.room_id} json={target.config}\n")


def encode_drop(room_id):
    if not _safe_token(room_id):
        raise LaunchError("target has no safe room id")
    return _command_line(f"Q2DZ/ROOMS/2 DROP room={room_id}\n")


def _target_from_config(config):
    if isinstance(config, HubTarget):
        return dataclasses.replace(config)
    if not isinstance(config, dict) or not isinstance(config.get("roomId"), str) or not config["roomId"]:
        raise LaunchError("hub room configuration has no room id")
    text = _config_text(config)
    return HubTarget(config["roomId"], text, 0, str(config.get("map", "")))


def _copy_targets(targets):
    if not isinstance(targets, dict):
        raise LaunchError("hub target state must be a room map")
    copied = {}
    for room_id, target in targets.items():
        normalized = _target_from_config(target)
        if room_id != normalized.room_id:
            raise LaunchError("hub target state key does not match room id")
        copied[room_id] = normalized
    if len(copied) > MAX_HUB_TARGETS:
        raise LaunchError("catalog_capacity_exceeded")
    return copied


def _validate_rows(rows):
    seen_rooms = set()
    seen_aliases = set()
    for row in rows:
        if not _strict_room(row):
            raise LaunchError("room catalog has an invalid schema")
        room_id = row["room"]
        if room_id in seen_rooms:
            raise LaunchError("room catalog has duplicate room ids")
        seen_rooms.add(room_id)
        alias = _room_alias(row)
        if alias in seen_aliases:
            raise LaunchError("room catalog has duplicate Q2 aliases")
        seen_aliases.add(alias)


def reconcile_targets(targets, rows, make_config, map_available=lambda _row: True):
    """Build one complete room-id snapshot without mutating the live state."""
    current = _copy_targets(targets)
    rows = list(rows)
    _validate_rows(rows)
    by_id = {row["room"]: row for row in rows}
    desired_rows = [
        row for row in rows
        if row["players"] < row["createSettings"]["maxPlayers"]
    ]
    if len(desired_rows) > MAX_HUB_TARGETS:
        raise LaunchError("catalog_capacity_exceeded")

    updated = {}
    drops = set()
    for room_id in sorted(current):
        target = current[room_id]
        row = by_id.get(room_id)
        if row is None:
            if target.misses < 1:
                updated[room_id] = dataclasses.replace(target, misses=target.misses + 1)
            else:
                drops.add(room_id)
            continue
        map_name = row["createSettings"]["map"]
        config_text = _config_text(make_config(row))
        previous_config = json.loads(target.config)
        fresh_config = json.loads(config_text)
        # ICE is refreshed separately; rotating TURN credentials must not drop a room.
        previous_config.pop("iceServers", None)
        fresh_config.pop("iceServers", None)
        changed = fresh_config != previous_config
        map_changed = bool(target.map_name) and target.map_name != map_name
        if changed and map_changed and not map_available(row):
            raise LaunchError("map content check failed")
        updated[room_id] = HubTarget(room_id, config_text, 0, map_name)
        if changed:
            drops.add(room_id)

    for row in sorted(desired_rows, key=lambda value: value["room"]):
        room_id = row["room"]
        if room_id in updated:
            continue
        if not map_available(row):
            raise LaunchError("map content check failed")
        if len(updated) >= MAX_HUB_TARGETS:
            continue
        config_text = _config_text(make_config(row))
        target = HubTarget(room_id, config_text, 0, row["createSettings"]["map"])
        encode_put(target)
        updated[room_id] = target

    if len(updated) > MAX_HUB_TARGETS:
        raise LaunchError("catalog_capacity_exceeded")
    return TargetPlan(updated, [], tuple(sorted(drops)))


def poll_once(targets, fetch, writer):
    """Apply one successful refresh; failures leave the room map untouched."""
    try:
        updated = fetch()
    except LaunchError:
        return targets
    writer(updated)
    return updated.targets if isinstance(updated, TargetPlan) else updated


def notify(message, level="error", zenity=_AUTO, output=sys.stderr, runner=subprocess.run):
    if zenity is _AUTO:
        zenity = shutil.which("zenity")
    if zenity and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        runner([zenity, f"--{level}", "--title=Q2PRO-X — Dos.Zone", f"--text={message}"], check=False)
    else:
        output.write(message + "\n")


def make_room_config(selected, lookup, rtc_rows, ice_servers=None):
    if not _strict_room(selected) or (selected["createSettings"]["prefix"] == "q2" and selected.get("roomReady") is not True):
        raise LaunchError("The selected room is no longer available")
    alias = _room_alias(selected)
    if not _safe_token(alias) or (not alias.startswith("q2.") and not alias.startswith("room.q2ded.")):
        raise LaunchError("selected room has no safe Q2 alias")
    if not validate_alias_payload(lookup) or alias not in lookup["aliases"]:
        raise LaunchError("selected room alias is no longer registered")
    if not validate_rtc_payload(rtc_rows):
        raise LaunchError("RTC configuration has an invalid schema")
    if ice_servers is None:
        ice_servers = _ice_snapshot(rtc_rows)
    elif not isinstance(ice_servers, list) or not 1 <= len(ice_servers) <= MAX_ICE_SERVERS:
        raise LaunchError("global RTC configuration has an invalid schema")
    config = {
        "version": 1,
        "roomId": selected["room"],
        "alias": alias,
        "signalingUrl": SIGNALING_URL,
        "ordered": False,
        "iceServers": ice_servers,
        "map": selected["createSettings"]["map"],
        "game": GAME,
    }
    if _room_kind(selected) == "q2ded" and len(_config_text(config).encode("utf-8")) > MAX_GATEWAY_CONFIG_BYTES:
        raise LaunchError("dedicated room configuration exceeds 65535 bytes")
    return config


def _config_dir():
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "q2pro-x-doszone"


def load_q2_path():
    path_file = _config_dir() / "q2-path"
    try:
        value = path_file.read_text(encoding="utf-8").strip()
    except OSError:
        return None
    path = Path(value).expanduser()
    return path.absolute() if path.is_file() else None


def save_q2_path(path):
    path = Path(path).expanduser().absolute()
    if not path.is_file():
        raise LaunchError("selected Q2PRO-X.exe does not exist")
    directory = _config_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=directory, prefix="q2-path.", delete=False
        ) as stream:
            temporary = Path(stream.name)
            os.chmod(stream.fileno(), 0o600)
            stream.write(str(path) + "\n")
        os.replace(temporary, directory / "q2-path")
    finally:
        if temporary and temporary.exists():
            temporary.unlink()


def _known_q2_paths():
    home = Path.home()
    candidates = [
        os.environ.get("Q2PROX_EXE"),
        os.environ.get("Q2DZ_Q2_EXE"),
        home / "Games" / "Quake2-PlayGround-2026" / "Q2PRO-X.exe",
        home / "Games" / "Q2PRO-X" / "Q2PRO-X.exe",
        home / "Games" / "Quake II" / "Q2PRO-X.exe",
        home / ".wine" / "drive_c" / "Program Files" / "Q2PRO-X" / "Q2PRO-X.exe",
    ]
    games = home / "Games"
    if games.is_dir():
        candidates.extend(games.glob("*/Q2PRO-X.exe"))
    seen = set()
    for candidate in candidates:
        if not candidate:
            continue
        path = Path(candidate).expanduser()
        key = str(path.absolute())
        if key not in seen:
            seen.add(key)
            yield path


def discover_q2():
    stored = load_q2_path()
    candidates = ([stored] if stored else []) + list(_known_q2_paths())
    for candidate in candidates:
        if candidate and candidate.is_file() and candidate.name.casefold() == "q2pro-x.exe":
            return candidate.absolute()
    return None


def select_q2_path(zenity=_AUTO, input_fn=input, output=sys.stderr, runner=subprocess.run):
    if zenity is _AUTO:
        zenity = shutil.which("zenity") if (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")) else None
    selected = None
    if zenity:
        action = runner(
            [zenity, "--question", "--title=Q2PRO-X is required",
             "--text=Select an existing Q2PRO-X.exe or open the official download page.",
             "--ok-label=Select Q2PRO-X.exe", "--cancel-label=Cancel",
             "--extra-button=Open download page"],
            capture_output=True,
            text=True,
            check=False,
        )
        if action.stdout.strip() == "Open download page":
            webbrowser.open(OFFICIAL_URL)
            output.write(f"Install Q2PRO-X first: {OFFICIAL_URL}\n")
            return None
        if action.returncode != 0:
            return None
        result = runner(
            [zenity, "--file-selection", "--title=Select your installed Q2PRO-X.exe",
             "--file-filter=Q2PRO-X.exe"],
            capture_output=True,
            text=True,
            check=False,
        )
        if result.returncode == 0:
            selected = result.stdout.strip()
    else:
        output.write("Q2PRO-X.exe is required: [s]elect, [o]pen download page, [c]ancel.\n")
        try:
            action = input_fn("Choice [s/o/c]: ").strip().casefold()
        except EOFError:
            action = "c"
        if action == "o":
            webbrowser.open(OFFICIAL_URL)
            output.write(f"Install Q2PRO-X first: {OFFICIAL_URL}\n")
            return None
        if action != "s":
            return None
        try:
            selected = input_fn("Path to your installed Q2PRO-X.exe: ").strip()
        except EOFError:
            selected = ""
    if selected:
        path = Path(selected).expanduser()
        if path.is_file() and path.name.casefold() == "q2pro-x.exe":
            save_q2_path(path)
            return path.absolute()
        output.write("That is not a readable Q2PRO-X.exe.\n")
    output.write(f"Install Q2PRO-X first: {OFFICIAL_URL}\n")
    return None


def _installed_paths():
    root = Path(__file__).resolve().parent
    return {
        "session": Path(os.environ.get("Q2DZ_SESSION_BIN", root / "q2dz-session")),
        "managed": Path(os.environ.get("Q2DZ_MANAGED_GATEWAY", root / "q2dz-webrtc-gateway")),
        "legacy": Path(os.environ.get("Q2DZ_LEGACY_GATEWAY", root / "q2dz-webrtc-gateway")),
        "adapter": Path(os.environ.get("Q2DZ_ADAPTER_CONFIG", root.parent / "config" / "legacy-gateway.json")),
        "content": Path(os.environ.get("Q2DZ_CONTENT_CHECK", root / "q2dz-content-check")),
    }


def content_ready(q2_path, map_name, content_checker=None, runner=subprocess.run):
    paths = _installed_paths()
    checker = Path(content_checker or paths["content"])
    result = runner(
        [str(checker), "--q2-root", str(Path(q2_path).parent), "--game", GAME, "--map", map_name],
        check=False,
    )
    return result.returncode == 0


def wait_child(process, timeout=10.0):
    try:
        return process.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        return None


def _write_bytes(process, line):
    encoded = bytearray(line.encode("utf-8"))
    try:
        process.stdin.write(bytes(encoded))
    except BrokenPipeError:
        code = wait_child(process)
        if code is None:
            raise LaunchError("coordinator closed stdin but did not exit")
        return code
    finally:
        encoded[:] = b"\x00" * len(encoded)
    return None


def write_heartbeat(process, plan, generation):
    if not isinstance(plan, TargetPlan):
        plan = TargetPlan(_copy_targets(plan), [], ())
    lines = []
    try:
        lines.append(encode_ice(generation, plan.ice_servers))
        lines.extend(encode_drop(room_id) for room_id in sorted(plan.drops))
        lines.extend(encode_put(plan.targets[room_id]) for room_id in sorted(plan.targets))
        for line in lines:
            code = _write_bytes(process, line)
            if code is not None:
                return code
        process.stdin.flush()
        return None
    except BrokenPipeError:
        code = wait_child(process)
        if code is None:
            raise LaunchError("coordinator closed stdin but did not exit")
        return code
    finally:
        lines.clear()


def _room_catalog_is_empty(catalog):
    return isinstance(catalog, dict) and catalog.get("rooms") == []


def refresh_targets(targets, q2_path, *, fetch=None, content_checker=None, runner=subprocess.run):
    fetch = fetch or fetch_json
    catalog = fetch(ROOM_ENDPOINT)
    if not validate_room_payload(catalog) and not _room_catalog_is_empty(catalog):
        try:
            ready_rooms(catalog)
        except LaunchError:
            raise
        raise LaunchError("room catalog has an invalid schema")
    lookup = fetch(LOOKUP_ENDPOINT)
    rows = registered_rooms(ready_rooms(catalog), lookup)
    rtc_rows = fetch(RTC_ENDPOINT)
    ice_servers = _ice_snapshot(rtc_rows)

    def make_config(row):
        return make_room_config(row, lookup, rtc_rows, ice_servers)

    plan = reconcile_targets(
        targets,
        rows,
        make_config,
        lambda row: content_ready(q2_path, row["createSettings"]["map"], content_checker, runner=runner),
    )
    plan.ice_servers = ice_servers
    return plan


def run_hub(configs, q2_path, *, session, managed, legacy, adapter,
            runner=None, popen=None, refresh=None, poll_interval=HUB_POLL_SECONDS):
    initial_plan = configs if isinstance(configs, TargetPlan) else None
    targets = _copy_targets(configs.targets) if initial_plan else (
        _copy_targets(configs) if isinstance(configs, dict) else _initial_targets(configs)
    )
    args = [
        str(session),
        "--gateway", str(managed),
        "--legacy-gateway", str(legacy),
        "--adapter", str(adapter),
        "--q2", str(q2_path),
        "--game", GAME,
    ]
    starter = popen or runner or subprocess.Popen
    process = starter(args, stdin=subprocess.PIPE)
    try:
        initial_ice = initial_plan.ice_servers if initial_plan else _targets_ice_servers(targets)
        if initial_ice:
            code = write_heartbeat(process, TargetPlan(targets, initial_ice), generation=1)
            if code is not None:
                return code
        refresh_fn = refresh or refresh_targets
        generation = 1
        while True:
            code = wait_child(process, timeout=poll_interval)
            if code is not None:
                return code
            child_code = None

            def publish(updated):
                nonlocal child_code
                nonlocal generation
                generation += 1
                child_code = write_heartbeat(process, updated, generation)

            targets = poll_once(
                targets,
                lambda: refresh_fn(targets, q2_path),
                publish,
            )
            if child_code is not None:
                return child_code
    finally:
        stdin = getattr(process, "stdin", None)
        if stdin:
            try:
                stdin.close()
            except BrokenPipeError:
                if process.poll() is None:
                    raise
        if process.poll() is None:
            try:
                process.wait(timeout=10.0)
            except subprocess.TimeoutExpired:
                process.terminate()
                try:
                    process.wait(timeout=5.0)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=5.0)


def _initial_targets(configs):
    if isinstance(configs, dict):
        return _copy_targets(configs)
    targets = {}
    for config in configs:
        target = _target_from_config(config)
        targets[target.room_id] = target
    return _copy_targets(targets)


def _targets_ice_servers(targets):
    for room_id in sorted(targets):
        try:
            config = json.loads(targets[room_id].config)
        except (TypeError, json.JSONDecodeError):
            continue
        if isinstance(config, dict) and isinstance(config.get("iceServers"), list):
            return config["iceServers"]
    return []


def make_hub_targets(catalog, lookup, rtc_rows, q2_path, *, content_checker=None, runner=subprocess.run):
    if not validate_room_payload(catalog) and not _room_catalog_is_empty(catalog):
        try:
            ready_rooms(catalog)
        except LaunchError:
            raise
        raise LaunchError("room catalog has an invalid schema")
    rows = registered_rooms(ready_rooms(catalog), lookup)
    ice_servers = _ice_snapshot(rtc_rows)
    plan = reconcile_targets(
        {}, rows,
        lambda row: make_room_config(row, lookup, rtc_rows, ice_servers),
        lambda row: content_ready(q2_path, row["createSettings"]["map"], content_checker, runner=runner),
    )
    return plan.targets


def make_hub_configs(catalog, lookup, rtc_rows, q2_path, *, content_checker=None, runner=subprocess.run):
    targets = make_hub_targets(catalog, lookup, rtc_rows, q2_path, content_checker=content_checker, runner=runner)
    return [json.loads(targets[room_id].config) for room_id in sorted(targets)]


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv == ["--help"]:
        print("Usage: q2dz-launch [--select-q2]\nOpen Q2PRO-X's Dos.Zone browser with compatible servers through Wine.")
        return 0
    if argv == ["--select-q2"]:
        return 0 if select_q2_path() else 3
    if argv:
        print(f"unknown option: {argv[0]}", file=sys.stderr)
        return 64
    try:
        q2_path = discover_q2() or select_q2_path()
        if not q2_path:
            return 3
        paths = _installed_paths()
        try:
            targets = refresh_targets({}, q2_path)
        except LaunchError:
            targets = TargetPlan({}, [])
        result = run_hub(
            targets,
            q2_path,
            session=paths["session"],
            managed=paths["managed"],
            legacy=paths["legacy"],
            adapter=paths["adapter"],
        )
        if result == ROOM_CLOSED_EXIT:
            notify("The Dos.Zone room was closed.", "info")
        elif result != 0:
            notify(f"Dos.Zone session ended unexpectedly (code {result}).")
        return result
    except LaunchError as exc:
        notify(f"Dos.Zone join unavailable: {exc}")
        return 2
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
